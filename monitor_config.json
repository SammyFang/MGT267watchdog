{
  "crawl": {
    "interval_minutes": 60,
    "timezone": "America/Los_Angeles",
    "entry_url": "https://op.responsive.net/sc/riverside267/entry.html",
    "login_url": "https://op.responsive.net/SupplyChain/SCAccess",
    "warehouse_inventory_url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+inventory&data=WH1",
    "standing_url": "https://op.responsive.net/SupplyChain/SCStanding",
    "plot_sources": [
      {
        "id": "warehouse_inventory",
        "section": "Warehouse",
        "label": "Inventory",
        "url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+inventory&data=WH1"
      },
      {
        "id": "warehouse_shipments",
        "section": "Warehouse",
        "label": "Shipments",
        "url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+shipments&data=SHIP1SEG1"
      },
      {
        "id": "factory_wip",
        "section": "Factory",
        "label": "WIP",
        "url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+wip&data=WIP1"
      },
      {
        "id": "hq_demand",
        "section": "Headquarters",
        "label": "Demand",
        "url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+demand&data=DEMAND1"
      },
      {
        "id": "hq_lost_demand",
        "section": "Headquarters",
        "label": "Lost Demand",
        "url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+lost+demand&data=LOST1"
      },
      {
        "id": "hq_cash_balance",
        "section": "Headquarters",
        "label": "Cash Balance",
        "url": "https://op.responsive.net/SupplyChain/SCPlotk?submit=plot+cash+balance&data=BALANCE"
      }
    ],
    "policy_pages": [
      {
        "id": "headquarters_calopeia",
        "section": "Headquarters",
        "region": "Calopeia",
        "label": "Headquarters",
        "url": "https://op.responsive.net/SupplyChain/SCCorp?submit=change"
      },
      {
        "id": "factory_calopeia",
        "section": "Factory",
        "region": "Calopeia",
        "label": "Factory",
        "url": "https://op.responsive.net/SupplyChain/SCFactory?action=change&region=1"
      },
      {
        "id": "warehouse_calopeia",
        "section": "Warehouse",
        "region": "Calopeia",
        "label": "Warehouse",
        "url": "https://op.responsive.net/SupplyChain/SCWarehouse?submit=change&region=1"
      },
      {
        "id": "warehouse_sorange",
        "section": "Warehouse",
        "region": "Sorange",
        "label": "Warehouse",
        "url": "https://op.responsive.net/SupplyChain/SCWarehouse?submit=change&region=2"
      },
      {
        "id": "warehouse_tyran",
        "section": "Warehouse",
        "region": "Tyran",
        "label": "Warehouse",
        "url": "https://op.responsive.net/SupplyChain/SCWarehouse?submit=change&region=3"
      },
      {
        "id": "warehouse_entworpe",
        "section": "Warehouse",
        "region": "Entworpe",
        "label": "Warehouse",
        "url": "https://op.responsive.net/SupplyChain/SCWarehouse?submit=change&region=4"
      }
    ]
  },
  "credentials": {
    "team_id_env": "SC_TEAM_ID",
    "password_env": "SC_PASSWORD",
    "institution_env": "SC_INSTITUTION",
    "default_institution": "riverside267"
  },
  "game_rules": {
    "end_day": 1460,
    "product_price_per_drum": 1450,
    "customer_fulfillment_cost_per_drum": 150,
    "holding_cost_per_drum_per_year": 100,
    "cash_interest_rate_annual_percent": 10,
    "order_response_hours": 24,
    "capacity_expansion_cost_per_drum_per_day": 50000,
    "capacity_expansion_lead_days": 90,
    "capacity_can_be_retired": false,
    "production_fixed_cost_per_batch": 1500,
    "production_variable_cost_per_drum": 1000,
    "truck_capacity_drums": 200,
    "truck_cost": 15000,
    "truck_lead_days": 7,
    "mail_cost_per_drum": 150,
    "mail_lead_days": 1,
    "priority_level_affects_supply_chain": false
  },
  "monitor": {
    "target_team": "group7",
    "warehouse_inventory_threshold": 450,
    "warehouse_inventory_threshold_enabled": false,
    "warning_minutes": 15,
    "send_report_every_run": true,
    "report_min_interval_minutes": 50,
    "gap_percentage_formula": "(target_cash - team_cash) / team_cash * 100",
    "alert_rules": [
      {
        "id": "warehouse_inventory_high",
        "enabled": false,
        "label": "Legacy warehouse inventory checkpoint",
        "metric": "warehouse_inventory:warehouse",
        "operator": ">=",
        "threshold": 450,
        "severity": "warning",
        "channels": ["hourly"],
        "message": "Disabled legacy static checkpoint; active alerts use served-region coverage and game timing instead."
      },
      {
        "id": "warehouse_stockout_risk",
        "label": "Warehouse stockout",
        "metric": "warehouse_inventory:warehouse",
        "operator": "<=",
        "threshold": 0,
        "severity": "critical",
        "channels": ["warning", "hourly"],
        "message": "Warehouse inventory is depleted; customer orders cannot be fulfilled without new stock."
      },
      {
        "id": "lost_demand_detected",
        "label": "Served lost demand detected",
        "metric": "derived:calopeia_served_lost_demand",
        "operator": ">",
        "threshold": 0,
        "severity": "critical",
        "channels": ["warning", "hourly"],
        "message": "Lost demand is present across regions served by Calopeia; inspect supply and shipment timing."
      },
      {
        "id": "lost_demand_rate_high",
        "label": "Lost demand rate high",
        "metric": "derived:lost_demand_rate",
        "operator": ">=",
        "threshold": 20,
        "severity": "critical",
        "channels": ["hourly"],
        "message": "Lost demand is high relative to demand."
      },
      {
        "id": "days_of_cover_low",
        "label": "Served cover below dynamic minimum",
        "metric": "derived:cover_shortage_gap",
        "operator": ">",
        "threshold": 0,
        "severity": "critical",
        "channels": ["warning", "hourly"],
        "message": "Served-region coverage is below the dynamic minimum; avoid stockout while checking pipeline timing."
      },
      {
        "id": "days_of_cover_high",
        "label": "Served cover above dynamic maximum",
        "metric": "derived:cover_excess_gap",
        "operator": ">",
        "threshold": 0,
        "severity": "warning",
        "channels": ["hourly"],
        "message": "Served-region coverage is above the dynamic maximum; reduce only gradually to avoid bullwhip."
      },
      {
        "id": "shipments_below_demand",
        "label": "Shipments below demand",
        "metric": "derived:shipment_shortage_gap",
        "operator": ">",
        "threshold": 0,
        "severity": "warning",
        "channels": ["hourly"],
        "message": "Shipments are below demand; check fulfillment capacity."
      },
      {
        "id": "endgame_obsolete_inventory_risk",
        "label": "Endgame obsolete inventory risk",
        "metric": "derived:endgame_excess_cover_gap",
        "operator": ">",
        "threshold": 0,
        "severity": "warning",
        "channels": ["hourly"],
        "message": "Inventory cover exceeds remaining demand horizon; avoid creating obsolete inventory near day 1460."
      },
      {
        "id": "cash_lead_narrow",
        "label": "Cash lead narrow",
        "metric": "derived:cash_lead_percent_vs_nearest",
        "operator": "<",
        "threshold": 5,
        "severity": "warning",
        "channels": ["hourly"],
        "message": "Cash lead over the nearest competitor is narrowing."
      }
    ],
    "metric_thresholds": {
      "warehouse_inventory:mail": {
        "label": "Warehouse mail inventory",
        "min": null,
        "max": null
      },
      "warehouse_inventory:truck": {
        "label": "Warehouse truck inventory",
        "min": null,
        "max": null
      },
      "warehouse_shipments:Calopeia": {
        "label": "Warehouse shipments",
        "min": null,
        "max": null
      },
      "factory_wip:Calopeia": {
        "label": "Factory WIP",
        "min": null,
        "max": null
      },
      "hq_demand:Calopeia": {
        "label": "Headquarters demand",
        "min": null,
        "max": null
      },
      "hq_lost_demand:Calopeia": {
        "label": "Headquarters lost demand",
        "min": null,
        "max": null
      },
      "hq_cash_balance:value": {
        "label": "Headquarters cash balance",
        "min": null,
        "max": null
      }
    }
  },
  "ai": {
    "enabled": true,
    "provider": "gemini",
    "api_key_env": "GEMINI_API_KEY",
    "model": "gemini-2.5-flash",
    "recommendation_language": "English",
    "max_suggestions": 4
  },
  "auto_adjust": {
    "enabled": true,
    "mode": "research_only",
    "allow_game_updates": false,
    "targets": {
      "days_of_cover_min": 2,
      "days_of_cover_max": 5,
      "days_of_cover_target": 3,
      "warehouse_inventory_low": 0,
      "warehouse_inventory_high": null,
      "lost_demand_max": 0,
      "shipment_to_demand_ratio_min": 0.9,
      "wip_to_demand_ratio_max": 3
    },
    "max_change_per_run": {
      "order_point": 25,
      "quantity": 25
    },
    "bounds": {
      "order_point_min": 0,
      "order_point_max": 999999,
      "quantity_min": 0,
      "quantity_max": 999999
    },
    "policy_baseline": {
      "factory": {
        "shipping_method": "mail",
        "order_point": 175,
        "quantity": 100,
        "priority": 0
      },
      "warehouse": {
        "shipping_method": "mail",
        "order_point": 175,
        "quantity": 100,
        "priority": 0
      }
    }
  },
  "policy_apply": {
    "enabled": true,
    "mode": "approval_required",
    "workflow_url": "https://github.com/SammyFang/MGT267watchdog/actions/workflows/apply-policy.yml",
    "allow_shipping_method_change": false,
    "max_numeric_changes_per_run": 4,
    "max_change_per_apply": {
      "order_point": 25,
      "quantity": 25
    },
    "guardrails": {
      "block_priority_changes": true,
      "block_capacity_changes": true,
      "block_decrease_when_lost_demand": true,
      "block_decrease_below_dynamic_cover_min": true,
      "block_increase_above_dynamic_cover_max_without_lost_demand": true,
      "block_truck_increase_inside_lead_time_window": true
    }
  },
  "backtest": {
    "enabled": true,
    "data_source": "current trigger crawl plot data",
    "horizon_days": 3,
    "inventory_threshold_candidates": [250, 350, 450, 600, 800, 1000],
    "days_of_cover_high_candidates": [3, 5, 7, 10],
    "days_of_cover_low_candidates": [0.5, 1, 2],
    "shipment_to_demand_ratio_candidates": [0.6, 0.8, 0.9, 1],
    "excess_cover_days": 5,
    "lost_demand_threshold": 0
  },
  "email": {
    "enabled": true,
    "game_entry_url": "https://op.responsive.net/sc/riverside267/entry.html",
    "recipients": [
      "950154@gmail.com",
      "wgong009@ucr.edu",
      "hhuan238@ucr.edu",
      "yfang097@ucr.edu"
    ],
    "subject_prefix": "MGT267 Warehouse Watchdog",
    "attach_excel": true,
    "footer": {
      "text": "Developed by Yung-Sian Fang",
      "url": "https://sammyfang.tw"
    }
  },
  "notifications": {
    "github_issue": {
      "enabled": true,
      "title": "MGT267 Watchdog Live Status"
    },
    "wecom": {
      "enabled": true,
      "webhook_url_env": "WECOM_WEBHOOK_URL",
      "notify_mode": "alerts"
    }
  },
  "output": {
    "state_dir": ".monitor-state",
    "latest_json": ".monitor-state/latest.json",
    "history_csv": ".monitor-state/history.csv",
    "warehouse_inventory_csv": ".monitor-state/warehouse_inventory_latest.csv",
    "standing_gaps_csv": ".monitor-state/standing_gaps_latest.csv",
    "operational_snapshot_csv": ".monitor-state/operational_snapshot_latest.csv",
    "policy_snapshot_csv": ".monitor-state/policy_snapshot_latest.csv",
    "adjustment_plan_json": ".monitor-state/adjustment_plan_latest.json",
    "adjustment_plan_csv": ".monitor-state/adjustment_plan_latest.csv",
    "policy_apply_json": ".monitor-state/policy_apply_latest.json",
    "policy_apply_csv": ".monitor-state/policy_apply_latest.csv",
    "backtest_json": ".monitor-state/backtest_latest.json",
    "backtest_summary_csv": ".monitor-state/backtest_summary_latest.csv",
    "backtest_daily_csv": ".monitor-state/backtest_daily_latest.csv",
    "backtest_xlsx": ".monitor-state/backtest_report_latest.xlsx",
    "data_workbook_xlsx": ".monitor-state/supply_chain_data_latest.xlsx",
    "email_delivery_json": ".monitor-state/email_delivery_latest.json",
    "status_site_dir": ".monitor-state/status-site"
  },
  "excel": {
    "exponential_smoothing_alpha": 0.3
  }
}
